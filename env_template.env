# Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados (Railway)
DATABASE_URL=
DB_REJECT_UNAUTHORIZED=false

# Autenticação e Segurança
JWT_SECRET=
ALLOWED_ORIGIN=
APP_BASE_URL=

# Motores de IA (APIs)
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_KEY=

# Armazenamento Stateless (Cloudinary)
CLOUDINARY_URL=

# Configuração de E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Pagamentos (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tabela de Custos (Créditos)
COST_TEXT_TO_IMAGE=1
COST_IMAGE_EDITOR=20
COST_TEXT_TO_VIDEO=5
COST_FACESWAP=3
COST_UPSCALE=5

# Admin
ADMIN_EMAILS=nilson@playground.com
